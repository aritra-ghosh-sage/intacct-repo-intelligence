# Copy this file to `.env` at the repo root for local Greenfield runs.
# Existing shell environment values still win if they are already set.

# Optional: local AWS settings for the Strands runtime.
# Strands can also use the standard AWS provider chain, so these do not need to
# be present if your shell or IAM role already provides credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# AWS_PROFILE=...
# Keep this aligned with `region` in config/greenfield_strands.example.yaml;
# Bedrock model access is granted per region.
AWS_REGION=us-west-2

# Required for NexAU planner mode.
LLM_API_KEY=
LLM_MODEL= #us.anthropic.claude-sonnet-4-5-20250929-v1:0
LLM_BASE_URL=

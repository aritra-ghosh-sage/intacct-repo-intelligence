# Copy this file to `.env` at the repo root for local Greenfield runs.
# Existing shell environment values still win if they are already set.

# Optional: local AWS settings for the Strands runtime.
# Strands can also use the standard AWS provider chain, so these do not need to
# be present if your shell or IAM role already provides credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# AWS_PROFILE=...
# Keep this aligned with `region` in config/greenfield_strands.example.yaml;
# Bedrock model access is granted per region.
AWS_REGION=us-west-2

# Required for native Bedrock Strands tracing. For GPT-5.6, use a Bedrock
# inference-profile ID, not the Mantle model ID used by NexAU.
STRANDS_MODEL=
# Example: STRANDS_MODEL=us.openai.gpt-5.6-luna

# Required for NexAU planner mode. This uses OpenAI-compatible Chat Completions
# through Bedrock Mantle; for GPT-5.6 Luna use the non-profile model ID below.
LLM_API_KEY=
LLM_MODEL=
# Example: LLM_MODEL=openai.gpt-5.6-luna
LLM_BASE_URL=https://bedrock-mantle.us-west-2.api.aws/openai/v1

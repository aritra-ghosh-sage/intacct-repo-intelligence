@@ -0,0 +1,89 @@
+#!/usr/bin/env bash
+# prhistoryboundcheck.sh — bounded PR-context history is explicit, deterministic, and effective.
+
+set -u
+ROOT="$( cd "$( dirname "$0" )/.." && pwd )"
+BIN="${1:-${RIPWIRE_BIN:-$ROOT/build/ripwire}}"
+[ "${BIN#/}" = "$BIN" ] && BIN="$ROOT/$BIN"
+TMP="$( mktemp -d )"; trap 'rm -rf "$TMP"' EXIT
+fail=0
+ok(){ printf '  PASS  %s\n' "$*"; }
+no(){ printf '  FAIL  %s\n' "$*"; fail=1; }
+
+[ -x "$BIN" ] || { echo "no ripwire binary at $BIN — build first"; exit 2; }
+REPO="$TMP/repo"
+mkdir -p "$REPO/src"
+git -C "$REPO" init -q
+
+commit_as(){
+    local email="$1" message="$2"
+    git -C "$REPO" -c user.email="$email" -c user.name="${email%@*}" add -A
+    GIT_AUTHOR_NAME="${email%@*}" GIT_AUTHOR_EMAIL="$email" \
+    GIT_COMMITTER_NAME="${email%@*}" GIT_COMMITTER_EMAIL="$email" \
+        git -C "$REPO" commit -qm "$message"
+}
+
+printf 'int core() { return 1; }\n' > "$REPO/src/core.cpp"
+printf 'int old_partner() { return 0; }\n' > "$REPO/src/old_partner.cpp"
+commit_as old@example.invalid base
+for n in 2 3; do
+    printf 'int core() { return %s; }\n' "$n" > "$REPO/src/core.cpp"
+    printf 'int old_partner() { return %s; }\n' "$n" > "$REPO/src/old_partner.cpp"
+    commit_as old@example.invalid "old-$n"
+done
+
+printf 'int recent_partner() { return 0; }\n' > "$REPO/src/recent_partner.cpp"
+for n in 4 5 6; do
+    printf 'int core() { return %s; }\n' "$n" > "$REPO/src/core.cpp"
+    printf 'int recent_partner() { return %s; }\n' "$n" > "$REPO/src/recent_partner.cpp"
+    commit_as recent@example.invalid "recent-$n"
+done
+
+printf 'int core() { return 3; }\n' > "$REPO/src/core.cpp"
+
+OUT="$($BIN "$REPO" --pr-context=HEAD --pr-history-commits=3 --no-cache 2>/dev/null)"
+[ -n "$OUT" ] && ok "bounded PR context emits output" || no "bounded PR context output is empty"
+printf '%s' "$OUT" | grep -q 'history_scope="head-count" history_commits="3"' \
+    && ok "root discloses the bounded history" || no "history bound is not disclosed"
+printf '%s' "$OUT" | grep -q 'window="last-3-commits@HEAD"' \
+    && ok "co-change row discloses the commit-count window" || no "co-change window does not disclose the bound"
+printf '%s' "$OUT" | grep -q 'recent_partner.cpp' \
+    && ok "recent co-change partner is retained" || no "recent co-change partner is missing"
+if printf '%s' "$OUT" | grep -q 'old_partner.cpp'; then
+    no "old co-change partner escaped the three-commit window"
+else
+    ok "old co-change partner is excluded by the three-commit window"
+fi
+printf '%s' "$OUT" | grep -q 'recent@example.invalid' \
+    && ok "recent owner is retained" || no "recent owner is missing"
+if printf '%s' "$OUT" | grep -q 'old@example.invalid'; then
+    no "old owner escaped the three-commit window"
+else
+    ok "old owner is excluded by the three-commit window"
+fi
+
+OUT2="$($BIN "$REPO" --pr-context=HEAD --pr-history-commits=3 --no-cache 2>/dev/null)"
+[ "$OUT" = "$OUT2" ] && ok "bounded PR context is deterministic" || no "bounded PR context differs between runs"
+
+DEFAULT="$($BIN "$REPO" --pr-context=HEAD --no-cache 2>/dev/null)"
+if printf '%s' "$DEFAULT" | grep -q '<pr-context[^>]*history_scope='; then
+    no "legacy PR context unexpectedly carries bounded-history attributes"
+else
+    ok "legacy PR context remains unbounded when the option is absent"
+fi
+
+for value in 0 -1 nope; do
+    if "$BIN" "$REPO" --pr-context=HEAD --pr-history-commits="$value" --no-cache >/dev/null 2>&1; then
+        no "invalid history value '$value' was accepted"
+    else
+        ok "invalid history value '$value' is rejected"
+    fi
+done
+
+if "$BIN" "$REPO" --pr-history-commits=1 --no-cache >/dev/null 2>&1; then
+    no "history option was accepted without --pr-context"
+else
+    ok "history option requires --pr-context"
+fi
+
+if [ "$fail" -eq 0 ]; then echo "ALL PASS"; exit 0; else echo "SOME CHECKS FAILED"; exit 1; fi

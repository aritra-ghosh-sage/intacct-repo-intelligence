@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# intacctaliasescheck.sh — every configured Intacct PHP-family suffix routes to PHP.
+
+set -u
+ROOT="$( cd "$( dirname "$0" )/.." && pwd )"
+BIN="${1:-${RIPWIRE_BIN:-$ROOT/build/ripwire}}"
+[ "${BIN#/}" = "$BIN" ] && BIN="$ROOT/$BIN"
+TMP="$( mktemp -d )"; trap 'rm -rf "$TMP"' EXIT
+fail=0
+ok(){ printf '  PASS  %s\n' "$*"; }
+no(){ printf '  FAIL  %s\n' "$*"; fail=1; }
+
+[ -x "$BIN" ] || { echo "no ripwire binary at $BIN — build first"; exit 2; }
+for extension in .php .phtml .cls .ent .inc .cqry .rpt .menu .pol .wfl .shortcuts .qry .bin .map; do
+    filename="Alias${extension#.}${extension}"
+    printf '<?php class Alias%s { function method%s() {} }\n' "${extension#.}" "${extension#.}" > "$TMP/$filename"
+done
+
+OUT="$($BIN "$TMP" --top-k=200 --no-cache 2>/dev/null)"
+for extension in .php .phtml .cls .ent .inc .cqry .rpt .menu .pol .wfl .shortcuts .qry .bin .map; do
+    filename="Alias${extension#.}${extension}"
+    if printf '%s' "$OUT" | grep -q "p=\"$filename\""; then
+        ok "$extension routes to the PHP parser"
+    else
+        no "$extension was skipped or not parsed"
+    fi
+done
+
+if [ "$fail" -eq 0 ]; then echo "ALL PASS"; exit 0; else echo "SOME CHECKS FAILED"; exit 1; fi

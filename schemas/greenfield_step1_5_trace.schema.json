{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "analysis_kind", "repository", "revision", "input", "changed_paths", "affected_symbols", "calls", "behaviors", "surfaces"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "analysis_kind": {"const": "greenfield_pr_impact_step_1_5"},
    "repository": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input": {"type": "object", "required": ["repository", "repo_key", "pr_number", "base_sha", "head_sha", "changed_paths"]},
    "changed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "affected_symbols": {"type": "array"},
    "calls": {"type": "array"},
    "behaviors": {"type": "array", "minItems": 1},
    "surfaces": {"type": "object"}
  },
  "additionalProperties": true
}

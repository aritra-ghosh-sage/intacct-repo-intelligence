{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "analysis_kind", "source_repository", "base_revision", "head_revision", "changed_paths", "evidence", "request_sha256"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "analysis_kind": {"const": "greenfield_pr_analysis_request"},
    "base_revision": {"pattern": "^[0-9a-f]{40}$"},
    "head_revision": {"pattern": "^[0-9a-f]{40}$"}
  }
}

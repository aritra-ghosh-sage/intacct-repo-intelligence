{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "analysis_kind", "status", "claims", "assessments"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "analysis_kind": {"const": "greenfield_test_assessment"},
    "status": {"enum": ["complete", "partial", "blocked"]},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "assessments": {"type": "array"}
  },
  "$defs": {
    "claim": {"type": "object", "required": ["repository", "inspected_revision", "evidence_status", "evidence", "rationale"], "properties": {"repository": {"type": "string", "minLength": 1}, "inspected_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "evidence_status": {"enum": ["confirmed", "candidate", "unavailable", "unresolved"]}, "evidence": {"type": "array", "minItems": 1}, "rationale": {"type": "string", "minLength": 1}}, "additionalProperties": true}
  }
}
